<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- example -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ponpeco Accessories</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_PAHHeadScarf"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_PAHHeadScarfB"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_PAHVeil"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>