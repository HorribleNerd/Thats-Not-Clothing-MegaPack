<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- example -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Psy Bone Masks - Remade</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_BoneMask_of_PsychicSensitivity"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_BoneMask_of_PsychicEntropy"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
				<li Class="PatchOperationAdd">
					<xpath>/Defs/ThingDef[defName="Apparel_BoneMask_Psychic"]/apparel</xpath>
					<value>
					  <countsAsClothingForNudity>false</countsAsClothingForNudity>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>